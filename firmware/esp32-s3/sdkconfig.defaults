CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# Use the ESP32-S3 built-in USB Serial/JTAG controller as the PRIMARY console.
# This lets the same USB-C connection handle flashing and serial monitoring.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Actual board module is ESP32-S3-WROOM-1U-N16R8: 16 MB flash / 8 MB PSRAM.
# Keep the flash tool aligned with the physical N16 module.
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Built-in W5500 SPI Ethernet. HMI is served on Ethernet via DHCP by default;
# Wi-Fi remains optional STA when SP01_WIFI_SSID is configured.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Current G1/G2 bench build: enable one-hot, auto-off DO pulse test from HMI.
# MACHINE / SOLENOIDS / CONTACTORS MUST REMAIN DISCONNECTED while this is enabled.
CONFIG_SP01_BENCH_DO_TEST_ENABLE=y
