menu "SP01 Filling Controller"

config SP01_CONTROL_PERIOD_MS
    int "Control period (ms)"
    range 2 100
    default 10

config SP01_TARGET_G
    int "Target weight (g)"
    range 1000 100000
    default 50000

config SP01_COARSE_TO_FINE_G
    int "Coarse-to-fine threshold (g)"
    range 1000 100000
    default 40000

config SP01_CUTOFF_MARGIN_G
    int "Cutoff margin below target (g)"
    range 0 5000
    default 0

config SP01_WEIGHT_STALE_MS
    int "Maximum weight age (ms)"
    range 20 5000
    default 500

config SP01_BAG_ACQUIRE_TIMEOUT_MS
    int "Bag acquire timeout (ms)"
    range 100 30000
    default 2000

config SP01_COARSE_TIMEOUT_MS
    int "Coarse fill timeout (ms)"
    range 500 30000
    default 12000

config SP01_FINE_TIMEOUT_MS
    int "Fine fill timeout (ms)"
    range 100 30000
    default 5000

config SP01_SETTLE_MIN_MS
    int "Minimum settle time (ms)"
    range 0 10000
    default 200

config SP01_WAIT_DISCHARGE_TIMEOUT_MS
    int "Wait discharge-reference timeout (ms)"
    range 100 30000
    default 6000

config SP01_PUSH_DURATION_MS
    int "Push output duration (ms)"
    range 50 5000
    default 500

config SP01_DISCHARGE_COUNTDOWN_COUNTS
    int "Normalized post-ref-B discharge countdown"
    range 1 10000
    default 1000
    help
        A-to-B travel is normalized to 1000 counts. This value defines the
        nominal post-B countdown before bag push.

config SP01_DISCHARGE_LEAD_COUNTS
    int "Discharge lead trim (normalized counts)"
    range 0 9999
    default 0
    help
        Subtracted from SP01_DISCHARGE_COUNTDOWN_COUNTS. Commission from
        measured sensor geometry and actuator response; do not guess in field.

config SP01_DI_INVERT_MASK
    hex "DI invert mask"
    range 0x00 0xFF
    default 0x00

config SP01_DO_INVERT_MASK
    hex "DO invert mask"
    range 0x00 0xFF
    default 0x00

config SP01_TLB_ENABLE
    bool "Enable TLB485 polling"
    default y

config SP01_TLB_BAUD
    int "TLB485 baud"
    default 9600

config SP01_TLB_SLAVE
    int "TLB485 Modbus address"
    range 1 99
    default 1

config SP01_TLB_POLL_MS
    int "TLB485 poll period (ms)"
    range 20 1000
    default 50

config SP01_TLB_CALIBRATION_WRITES
    bool "Enable TLB calibration writes from service HMI"
    default n
    help
        Enable only after the exact installed TLB485 protocol/manual revision
        has been checked. Runtime interlocks still require machine stopped,
        fill switch OFF, outputs safe, healthy fresh stable weight, and service token.

config SP01_WIFI_SSID
    string "Dedicated Wi-Fi SSID"
    default ""

config SP01_WIFI_PASSWORD
    string "Dedicated Wi-Fi password"
    default ""

config SP01_SERVICE_TOKEN
    string "Service token for calibration writes"
    default ""
    help
        No default token. If empty, calibration HTTP writes are rejected.

endmenu
